{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@choom/stream": ["vendor/choom-stream/index"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "scripts/**/*.cts"]
}
